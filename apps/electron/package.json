{
  "name": "smart-pet-agent",
  "version": "1.0.0",
  "description": "Smart Pet Agent — Ever-evolving AI OS companion",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "node ../../scripts/build-agent-runtime.mjs && electron-builder",
    "build:linux": "node ../../scripts/build-agent-runtime.mjs && electron-builder --linux",
    "build:win": "node ../../scripts/build-agent-runtime.mjs && electron-builder --win",
    "build:mac": "node ../../scripts/build-agent-runtime.mjs && electron-builder --mac"
  },
  "keywords": ["ai", "agent", "pet", "desktop", "overlay"],
  "homepage": "https://www.streetsmartnyc.cloud",
  "author": "Smart Pet Agent Contributors <support@streetsmartnyc.cloud>",
  "license": "MIT",
  "dependencies": {
    "conf": "^10.2.0",
    "better-sqlite3": "^11.0.0",
    "dot-prop": "^6.0.1",
    "electron-store": "^8.2.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  }
}
