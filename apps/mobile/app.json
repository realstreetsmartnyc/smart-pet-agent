{
  "expo": {
    "name": "Smart Pet Agent",
    "slug": "smart-pet-agent",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartpetagent",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0d10"
    },
    "ios": {
      "bundleIdentifier": "ai.smartpet.agent",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Smart Pet Agent needs camera for peripherals you approve",
        "NSMicrophoneUsageDescription": "Smart Pet Agent needs microphone for voice you approve",
        "NSPhotoLibraryUsageDescription": "Smart Pet Agent needs photo library for pet packs you import"
      },
      "supportsTablet": true
    },
    "android": {
      "package": "ai.smartpet.agent",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0d10"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "smartpetagent"
          }
        }
      ],
      "useNextNotificationsApi": true
    },
    "plugins": [
      "./plugins/withFirebaseInit",
      [
        "expo-build-properties",
        {
          "android": {
            "googleServicesFile": "./android/app/google-services.json"
          }
        }
      ],
      [
        "expo-firebase-core",
        {
          "googleServicesFile": "./ios/GoogleService-Info.plist"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Smart Pet Agent needs camera access for peripheral vision you approve."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Smart Pet Agent needs photo library access to import custom pet packs."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_REAL_EXPO_UUID"
      }
    }
  }
}
