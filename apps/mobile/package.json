{
  "name": "@smart-pet/mobile",
  "version": "1.0.0",
  "description": "Smart Pet Agent Mobile — React Native / Expo shell reusing packages/core for Android/iOS",
  "main": "src/index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "CI=1 npx expo prebuild --platform android --clean",
    "build:android:local": "cd android && ./gradlew assembleDebug",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/mobile-smoke.sh"
  },
  "dependencies": {
    "@smart-pet/core": "file:../../packages/core",
    "expo": "~51.0.0",
    "expo-av": "~14.0.0",
    "expo-camera": "~15.0.16",
    "expo-haptics": "~13.0.0",
    "expo-local-authentication": "~14.0.0",
    "expo-media-library": "~16.0.0",
    "expo-notifications": "~0.28.0",
    "expo-splash-screen": "~0.27.0",
    "expo-sqlite": "~14.0.0",
    "expo-status-bar": "~1.12.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@types/react": "~18.2.0",
    "@types/react-native": "~0.73.0",
    "typescript": "^5.3.3"
  }
}
